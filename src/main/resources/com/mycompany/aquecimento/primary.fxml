<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.aquecimento.PrimaryController">
 
    <ImageView fx:id="logo" fitHeight="120" preserveRatio="true" >
        <image>
            <Image url="@/com/mycompany/aquecimento/logo.png" />
        </image>
    </ImageView>
    
      <Button fx:id="um" text="Nova Reserva" onAction="#nova"/>
      
      <Button fx:id="dois" text="Ver reservas" onAction="#lista"/>
   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   
</VBox>
