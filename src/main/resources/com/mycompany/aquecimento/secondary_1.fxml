
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.aquecimento.SecondaryController1">

    <Label text="Lista de Reservas"/>

    <TextArea fx:id="txtReservas"
              editable="false"
              VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER" spacing="20.0">

        <Button text="Atualizar lista"
                onAction="#atualizarLista"/>

        <Button text="Voltar"
                onAction="#switchToPrimary"/>

    </HBox>

    <padding>
        <Insets bottom="20.0"
                left="20.0"
                right="20.0"
                top="20.0"/>
    </padding>

</VBox>
